generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String

  profile   Profile?
  images    ProfileImage[]
  plans     Plan[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Profile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  name              String?  // User's display name
  height            Float?   // cm
  weight            Float?   // kg
  age               Int?
  gender            String?  // "Male", "Female", "Other"
  fitnessGoal       String?  // "Lose Fat", "Build Muscle", etc.
  dietPreference    String?  // "Veg", "Non-Veg", etc.
  activityLevel     String?  // "Sedentary", "Active", etc.
  medicalConditions String?  // Optional text field for health conditions
  planDuration      Int?     // Desired plan duration in weeks

  user              User     @relation(fields: [userId], references: [id])
}

model ProfileImage {
  id        Int      @id @default(autoincrement())
  userId    Int
  imageUrl  String
  type      String   // "front", "side", "back"

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Plan {
  id         Int      @id @default(autoincrement())
  userId     Int
  workout    Json     // JSON object for structured plan
  diet       Json     // JSON object for structured plan
  duration   Int?     // Plan duration in weeks (4, 8, 12, etc.)
  version    Int      @default(1)

  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}
