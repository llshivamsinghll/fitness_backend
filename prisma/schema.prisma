generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String

  profile          Profile?
  images           ProfileImage[]
  plans            Plan[]
  planDailyProgresses PlanDailyProgress[] @relation("PlanDailyProgresses")
  workoutLogs      WorkoutLog[]        @relation("WorkoutLogs")
  bodyMeasurements BodyMeasurement[]   @relation("BodyMeasurements")
  achievements     Achievement[]       @relation("Achievements")
  personalRecords  PersonalRecord[]    @relation("PersonalRecords")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Profile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  name              String?  // User's display name
  height            Float?   // cm
  weight            Float?   // kg
  age               Int?
  gender            String?  // "Male", "Female", "Other"
  fitnessGoal       String?  // "Lose Fat", "Build Muscle", etc.
  dietPreference    String?  // "Veg", "Non-Veg", etc.
  activityLevel     String?  // "Sedentary", "Active", etc.
  medicalConditions String?  // Optional text field for health conditions
  planDuration      Int?     // Desired plan duration in weeks
  location          String?  // User's location/region (country, city, or region)
  state             String?  // User's state/region within a country (e.g., Maharashtra)
  cuisine           String?  // Preferred cuisine style (e.g., "Indian", "Mediterranean", "Asian")

  user              User     @relation(fields: [userId], references: [id])
}

model ProfileImage {
  id        Int      @id @default(autoincrement())
  userId    Int
  imageUrl  String
  type      String   // "front", "side", "back"

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Plan {
  id         Int      @id @default(autoincrement())
  userId     Int
  workout    Json     // JSON object for structured plan
  diet       Json     // JSON object for structured plan
  duration   Int?     // Plan duration in weeks (4, 8, 12, etc.)
  version    Int      @default(1)

  user       User     @relation(fields: [userId], references: [id])
  dailyProgress PlanDailyProgress[] @relation("PlanToDailyProgress")
  createdAt  DateTime @default(now())
}

model PlanDailyProgress {
  id                 Int      @id @default(autoincrement())
  userId             Int
  planId             Int
  planDay            Int
  completedExercises Json?
  completedMeals     Json?
  currentSet         Json?
  workoutTimer       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], name: "PlanDailyProgresses")
  plan Plan @relation(fields: [planId], references: [id], name: "PlanToDailyProgress")

  @@unique([userId, planId, planDay])
  @@index([userId, planId])
}

model WorkoutLog {
  id              Int      @id @default(autoincrement())
  userId          Int
  exerciseName    String
  sets            Int
  reps            Int
  weight          Float?   // Weight used in kg
  duration        Int?     // Duration in seconds
  notes           String?
  difficulty      String?  // "Easy", "Medium", "Hard"
  completedAt     DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], name: "WorkoutLogs")
  
  @@index([userId, completedAt])
}

model BodyMeasurement {
  id              Int      @id @default(autoincrement())
  userId          Int
  weight          Float?   // kg
  bodyFat         Float?   // percentage
  muscleMass      Float?   // kg
  chest           Float?   // cm
  waist           Float?   // cm
  hips            Float?   // cm
  biceps          Float?   // cm
  thighs          Float?   // cm
  notes           String?
  measuredAt      DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], name: "BodyMeasurements")
  
  @@index([userId, measuredAt])
}

model Achievement {
  id              Int      @id @default(autoincrement())
  userId          Int
  type            String   // "WORKOUT_STREAK", "WEIGHT_MILESTONE", "EXERCISE_PR", etc.
  title           String
  description     String
  icon            String?  // Icon identifier
  unlockedAt      DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], name: "Achievements")
  
  @@index([userId, unlockedAt])
}

model PersonalRecord {
  id              Int      @id @default(autoincrement())
  userId          Int
  exerciseName    String
  recordType      String   // "MAX_WEIGHT", "MAX_REPS", "TOTAL_VOLUME"
  value           Float
  unit            String   // "kg", "reps", "kg*reps"
  achievedAt      DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], name: "PersonalRecords")
  
  @@index([userId, exerciseName])
  @@unique([userId, exerciseName, recordType])
}
