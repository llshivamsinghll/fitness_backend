// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id    Int     @id @default(autoincrement())
  name  String
  email String  @unique
  password String
  
  // Profile Information
  height Float?  // in cm
  weight Float?  // in kg
  age    Int?
  gender String? // "Male", "Female", "Other"
  
  // Fitness Information
  fitnessGoal     String? // "Lose Fat", "Build Muscle", "Maintain", "Endurance", "Strength"
  dietPreference  String? // "Vegetarian", "Non-Vegetarian", "Vegan", "Keto", "Paleo", "Mediterranean"
  activityLevel   String? // "Sedentary", "Lightly Active", "Moderately Active", "Very Active", "Extremely Active"
  
  // Medical & Additional Info
  medicalConditions String? // Optional text field for conditions/restrictions
  profileImages     String[] // Array of image URLs (front, side, back)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
